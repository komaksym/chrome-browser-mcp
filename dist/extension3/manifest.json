{
  "manifest_version": 3,
  "name": "Chrome Browser MCP Agent",
  "version": "0.1.24",
  "description": "Local Chrome read/write access for a private ChatGPT MCP app.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chrome Browser MCP Agent"
  }
}
