{
  "name": "chrome-browser-mcp",
  "version": "0.1.3.5",
  "private": true,
  "type": "module",
  "description": "A local Chrome browser bridge for ChatGPT via MCP with user-directed read/write actions.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "npm run clean && npm run build:bridge && npm run build:extension",
    "build:bridge": "tsc -p tsconfig.bridge.json",
    "build:extension": "node scripts/build-extension.mjs",
    "artifacts:check": "node scripts/check-runtime-artifacts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && xvfb-run -a node tests/e2e/chrome-native-mcp.e2e.mjs",
    "check": "npm run version:check && npm run typecheck && npm run lint && npm test && npm run artifacts:check && npm run audit && npm run test:e2e",
    "version:check": "node scripts/check-version-bump.mjs",
    "dev:bridge": "tsx src/bridge/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector@latest http://127.0.0.1:2091/mcp",
    "install:mac": "bash scripts/install-macos.sh",
    "uninstall:mac": "bash scripts/uninstall-macos.sh",
    "audit": "npm audit --audit-level=high",
    "verify:local": "node scripts/verify-local.mjs",
    "configure:tunnel": "bash scripts/configure-tunnel.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.1.32",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.1.10"
  }
}
